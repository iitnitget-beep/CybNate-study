rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Deny everything by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Public assets (exam images, diagrams, formulas)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // User profile pictures and user-uploaded test notes
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
