rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // app.always() is enforced once App Check is enabled on the project.
    function appVerified() { return request.auth != null && request.app != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isStr(v, max) { return v is string && v.size() <= max; }
    function isInt(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function isNum(v, lo, hi) { return v is number && v >= lo && v <= hi; }

    // ---------- Exam content: signed-in users can read, nobody can write from the client ----------
    match /Exams/{document=**}  { allow read: if appVerified(); allow write: if false; }
    match /exams/{document=**}  { allow read: if appVerified(); allow write: if false; }
    match /categories/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Categories/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /subjects/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Subjects/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /tests/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Tests/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /chapters/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Chapters/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /questions/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Questions/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /modules/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Modules/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /lessons/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Lessons/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /syllabus/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Syllabus/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /mockTests/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /MockTests/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /testSeries/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /TestSeries/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /practice/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Practice/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /content/{document=**} { allow read: if appVerified(); allow write: if false; }
    match /Content/{document=**} { allow read: if appVerified(); allow write: if false; }

    match /{path=**}/Questions/{id} { allow read: if appVerified(); allow write: if false; }
    match /{path=**}/questions/{id} { allow read: if appVerified(); allow write: if false; }
    match /{path=**}/Tests/{id}     { allow read: if appVerified(); allow write: if false; }
    match /{path=**}/tests/{id}     { allow read: if appVerified(); allow write: if false; }
    match /{path=**}/Chapters/{id}  { allow read: if appVerified(); allow write: if false; }
    match /{path=**}/chapters/{id}  { allow read: if appVerified(); allow write: if false; }
    match /{path=**}/Subjects/{id}  { allow read: if appVerified(); allow write: if false; }
    match /{path=**}/subjects/{id}  { allow read: if appVerified(); allow write: if false; }
    match /{path=**}/Topics/{id}    { allow read: if appVerified(); allow write: if false; }
    match /{path=**}/topics/{id}    { allow read: if appVerified(); allow write: if false; }

    // ---------- User data ----------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      function validAttempt() {
        let d = request.resource.data;
        return d.keys().hasOnly(['userId','testId','testTitle','exam','examKey','subject','chapter',
                                 'topic','difficulty','score','totalMarks','correctCount','wrongCount',
                                 'skippedCount','timeTakenSeconds','answers','questionIds','completed','createdAt'])
          && d.keys().hasAll(['userId','testId','score','totalMarks','correctCount','wrongCount',
                              'skippedCount','timeTakenSeconds','answers','createdAt'])
          && d.userId == uid
          && d.createdAt == request.time
          && isStr(d.testId, 200)
          && (!('testTitle' in d.keys()) || isStr(d.testTitle, 300))
          && (!('exam' in d.keys()) || isStr(d.exam, 100))
          && (!('examKey' in d.keys()) || isStr(d.examKey, 100))
          && (!('subject' in d.keys()) || isStr(d.subject, 100))
          && (!('chapter' in d.keys()) || isStr(d.chapter, 300))
          && (!('topic' in d.keys()) || isStr(d.topic, 300))
          && (!('difficulty' in d.keys()) || isStr(d.difficulty, 30))
          && isNum(d.totalMarks, 1, 2000)
          && isNum(d.score, -2000, 2000) && d.score <= d.totalMarks
          && isInt(d.correctCount, 0, 500) && isInt(d.wrongCount, 0, 500) && isInt(d.skippedCount, 0, 500)
          && d.correctCount + d.wrongCount + d.skippedCount <= 500
          && isInt(d.timeTakenSeconds, 0, 86400)
          && d.answers is map && d.answers.size() <= 500
          && (!('questionIds' in d.keys()) || (d.questionIds is list && d.questionIds.size() <= 500));
      }

      match /attempts/{attemptId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validAttempt();
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['userId','questionId','testId','exam','questionText','createdAt'])
          && request.resource.data.userId == uid
          && request.resource.data.createdAt == request.time
          && isStr(request.resource.data.questionId, 200)
          && isStr(request.resource.data.questionText, 5000);
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
