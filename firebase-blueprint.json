{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Subject or exam category for tests",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Display name of the category" },
        "icon": { "type": "string", "description": "Icon identifier or name" },
        "order": { "type": "integer", "description": "Sorting order" },
        "description": { "type": "string", "description": "Brief description of the subject or exam" },
        "totalTests": { "type": "integer", "description": "Number of available tests" }
      },
      "required": ["name", "icon", "order"]
    },
    "Test": {
      "title": "Test",
      "description": "Quiz or mock examination paper",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Test title" },
        "categoryId": { "type": "string", "description": "Category document ID" },
        "duration": { "type": "integer", "description": "Duration in minutes" },
        "totalMarks": { "type": "integer", "description": "Maximum marks attainable" },
        "negativeMarking": { "type": "number", "description": "Negative marks deducted per incorrect answer" },
        "totalQuestions": { "type": "integer", "description": "Total number of questions in test" },
        "description": { "type": "string", "description": "Instructions or test description" },
        "difficulty": { "type": "string", "description": "Difficulty level (Easy, Medium, Hard)" }
      },
      "required": ["title", "categoryId", "duration", "totalMarks"]
    },
    "Question": {
      "title": "Question",
      "description": "Multiple-choice test question with 4 options and explanation",
      "type": "object",
      "properties": {
        "testId": { "type": "string", "description": "Test document ID" },
        "text": { "type": "string", "description": "Question statement" },
        "options": {
          "type": "array",
          "description": "Array of 4 option text strings"
        },
        "correctIndex": { "type": "integer", "description": "0-based index of correct option" },
        "explanation": { "type": "string", "description": "Detailed explanation of correct answer" },
        "marks": { "type": "number", "description": "Marks awarded for correct answer" },
        "imageUrl": { "type": "string", "description": "Optional image URL diagram" },
        "order": { "type": "integer", "description": "Question position in test" }
      },
      "required": ["testId", "text", "options", "correctIndex", "explanation", "marks"]
    },
    "Attempt": {
      "title": "Attempt",
      "description": "User test attempt record with score, question timings and answers",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "testId": { "type": "string", "description": "Test document ID" },
        "testTitle": { "type": "string", "description": "Snapshot of test title" },
        "score": { "type": "number", "description": "Total score achieved" },
        "totalMarks": { "type": "number", "description": "Maximum marks for the test" },
        "correctCount": { "type": "integer", "description": "Number of correct answers" },
        "wrongCount": { "type": "integer", "description": "Number of wrong answers" },
        "skippedCount": { "type": "integer", "description": "Number of skipped questions" },
        "timeTakenSeconds": { "type": "integer", "description": "Duration spent on test in seconds" },
        "answers": { "type": "object", "description": "Map of questionId to selected option index" },
        "completed": { "type": "boolean", "description": "Whether attempt was finished or auto-submitted" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of submission" }
      },
      "required": ["userId", "testId", "score", "totalMarks", "correctCount", "wrongCount", "skippedCount", "timeTakenSeconds", "completed", "createdAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Bookmarked question for future revision",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "questionId": { "type": "string", "description": "Bookmarked question ID" },
        "testId": { "type": "string", "description": "Associated test ID" },
        "questionText": { "type": "string", "description": "Cached question text" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["userId", "questionId", "testId", "createdAt"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Subjects or categories collection"
    },
    "/tests/{testId}": {
      "schema": "Test",
      "description": "Tests collection"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Questions bank collection"
    },
    "/users/{userId}/attempts/{attemptId}": {
      "schema": "Attempt",
      "description": "User test attempts history"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "User saved/bookmarked questions for review"
    }
  }
}
